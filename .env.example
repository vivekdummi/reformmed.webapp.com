# ── REFORMMED Monitor — Environment Config ─────────────────────────────────
# Copy this to .env and fill in your values

VM_PUBLIC_IP=YOUR.VM.PUBLIC.IP

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=reformmed
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=monitor_machine
POSTGRES_PORT=5432

# ── FastAPI metrics ingestion secret (used by all agents) ───────────────────
API_SECRET=your_random_secret_key_here

# ── Flask webapp ─────────────────────────────────────────────────────────────
FLASK_SECRET=change-this-to-a-random-long-string
FLASK_DEBUG=0
# Encrypts SMTP credentials saved via Settings. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
# Set to 0 only when testing over plain http://localhost
SESSION_COOKIE_SECURE=1

# ── Email alerts (Gmail App Password — NOT your real Gmail password) ─────────
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USER=your@gmail.com
GMAIL_APP_PASS=xxxxxxxxxxxxxxxxxxxx
ALERT_TO=alert1@email.com,alert2@email.com

# ── AI Review (Gemini — via Google AI Studio, free tier, no GCP billing needed) ──
# Get a key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google SSO (optional — login form works fine without these) ─────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ── Offline checker settings ─────────────────────────────────────────────────
OFFLINE_AFTER_SECS=60
CHECK_INTERVAL_SECS=15

# ─────────────────────────────────────────────────────────────────────────────
# First admin account: created on first start only if no admin exists.
# Username "admin", password from ADMIN_INITIAL_PASSWORD (or a random one
# printed once to the webapp log). Change it after first login.
ADMIN_INITIAL_PASSWORD=
# ─────────────────────────────────────────────────────────────────────────────
